# =========================
# MedVerse Environment
# =========================

# PostgreSQL
POSTGRES_USER=medverse_user
POSTGRES_PASSWORD=medverse_password
POSTGRES_DB=medverse_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# JWT
# Generate with:
# openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_BASE64_SECRET_AT_LEAST_64_BYTES
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Default admin account
DEFAULT_ADMIN_EMAIL=admin@medverse.vn
DEFAULT_ADMIN_PASSWORD=Admin@123456

# Frontend
FRONTEND_BASE_URL=http://localhost:3000

# AI Service - dùng ở task sau
AI_SERVICE_BASE_URL=http://localhost:8000
AI_TIMEOUT_MS=5000

# Mail
# For local testing, you may keep fake values if you only test admin login.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password